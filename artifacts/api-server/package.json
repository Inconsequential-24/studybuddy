{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.retry-tests.json",
    "test:ingestion": "node --import tsx --test tests/tutor-ingestion.test.ts tests/tutor-model-output.test.ts",
    "test:storage": "node --import tsx --test tests/local-object-storage.test.ts",
    "test:speech": "node --import tsx --test tests/mms-tts.test.ts tests/groq-stt.test.ts",
    "test:retry-browser": "playwright test --config playwright.retry.config.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.77",
    "@clerk/shared": "^4.39.1",
    "@google-cloud/storage": "^8.3.0",
    "@google/genai": "^1.52.0",
    "@napi-rs/canvas": "^1.0.10",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.2.0",
    "http-proxy-middleware": "^4.2.0",
    "pdfjs-dist": "^6.4.299",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "unpdf": "^1.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}

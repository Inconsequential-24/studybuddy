# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Database (local Postgres) ---
DATABASE_URL=postgresql://localhost:5432/studybuddy

# --- Gemini (get a key at https://aistudio.google.com/apikey) ---
AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-api-key
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Sign-in ---
# local = no sign-in, single local user, localhost only (dev). Unset = Clerk.
AUTH_DRIVER=local
# Clerk keys (only needed when AUTH_DRIVER is unset; https://dashboard.clerk.com -> API Keys)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- PDF storage ---
# local = save PDFs on disk (dev only). Unset/replit = Replit App Storage.
STORAGE_DRIVER=local
# Absolute path; blank = <repo>/.local/storage (git-ignored)
LOCAL_STORAGE_DIR=
# Replit App Storage only:
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Ports / local wiring ---
API_PORT=8080
WEB_PORT=5173
API_PROXY_TARGET=http://localhost:8080
LOG_LEVEL=info

# --- Optional voice features (leave blank to run without them) ---
# Read-aloud uses a Hugging Face MMS endpoint. Voice input uses Groq.
# HF_MMS_ENDPOINT_URL=
# HF_TOKEN=
# HF_MMS_LANGUAGE=en-US
# GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3-turbo
